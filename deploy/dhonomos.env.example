# Copy to deploy/dhonomos.env + fill in every secret below.
# Secrets empty on purpose: sample value -> Dhonomos refuses to start. Random value:
#   openssl rand -base64 32
POSTGRES_PASSWORD=
# First operator account `admin`. >= 10 chars; "change-me" and similar refused.
DHONOMOS_ADMIN_PASSWORD=
# Signs download/upload/BulkData links + derives STUN passwords -> keep stable.
# >= 32 bytes -> output of `openssl rand -base64 32` fits.
DHONOMOS_FILES_SECRET=
# Base64 32-byte key -> encrypts stored device credentials + task passwords.
DHONOMOS_SECRETS_KEY=
# Rotation: new key above + new id here + old key below, until the log says none left under
# it (docs/guide/operations.md).
# DHONOMOS_SECRETS_KEY_ID=k2
# DHONOMOS_SECRETS_OLD_KEYS=
# How CPEs reach the file server (signed links point here).
# https:// when the file server has TLS (below) or sits behind a TLS proxy.
DHONOMOS_FILES_PUBLIC_URL=http://acs.example.net:7548
# HTTPS for the file server: PEM files mounted into the container, both or neither.
# Re-read on change (check 1/min) -> renewal needs no restart.
# DHONOMOS_FILES_TLS_CERT=/run/secrets/files-cert.pem
# DHONOMOS_FILES_TLS_KEY=/run/secrets/files-key.pem
# Copy of the audit log -> SIEM or log collector (signed JSON batches):
# DHONOMOS_AUDIT_WEBHOOK_URL=https://siem.example.net/dhonomos
# Signs the batches (X-Dhonomos-Signature). Without it -> receiver cannot tell them from forged:
# DHONOMOS_AUDIT_WEBHOOK_SECRET=
# Firmware campaigns: cap file server bandwidth (Mbit/s) + parallel downloads.
# DHONOMOS_FILES_TOTAL_MBPS=500
# DHONOMOS_FILES_DOWNLOAD_MBPS=20
# DHONOMOS_FILES_MAX_DOWNLOADS=200
# ACS needs TLS: certificate + key (PEM files mounted into the container;
# re-read on change) ...
# DHONOMOS_ACS_TLS_CERT=/run/secrets/acs-cert.pem
# DHONOMOS_ACS_TLS_KEY=/run/secrets/acs-key.pem
# ... or plain HTTP: only behind a TLS-terminating proxy or in an isolated lab.
# No proxy -> CPE passwords cross the network in clear text.
# DHONOMOS_ACS_PLAINTEXT=true
# CPE auth to the ACS (HTTP Digest): one username + password shared by all CPEs,
# or per-device credentials (DHONOMOS_ACS_AUTH_PER_DEVICE below).
# `none` -> any client accepted as any CPE: isolated lab only (warning on a network address).
DHONOMOS_CPE_AUTH=digest
# DHONOMOS_CPE_USERNAME=cpe
# DHONOMOS_CPE_PASSWORD=
# API + UI have no TLS of their own -> compose publishes them on 127.0.0.1 only,
# behind a TLS-terminating reverse proxy (docs/guide/install.md).
# UI then always reached over HTTPS -> set this; without it a warning is logged.
# DHONOMOS_SECURE_COOKIES=true
# UI on the internet behind a TLS reverse proxy on this host (docs/guide/operations.md section 2b).
# TRUSTED_PROXIES: proxy address; forwarded client addresses believed only from it
# (Docker -> bridge gateway). PUBLIC_URL: public https address; cross-site request check
# compares against it exactly. SESSION_*: UI session limits.
# DHONOMOS_TRUSTED_PROXIES=127.0.0.1/32
# DHONOMOS_PUBLIC_URL=https://rms.example.org
# DHONOMOS_SESSION_HOURS=8
# DHONOMOS_SESSION_IDLE_MINUTES=30
# Per-device ACS credentials set at zero-touch (needs DHONOMOS_SECRETS_KEY + CPE auth).
# Device used its own once -> shared CPE password stops working for it.
# DHONOMOS_ACS_AUTH_PER_DEVICE=true
# Connection requests: refuse networks the ACS must never reach.
# Loopback, link-local + metadata addresses: always refused unless explicitly allowed.
# DHONOMOS_CR_DENY=10.0.0.0/24
# DHONOMOS_CR_ALLOW=100.64.0.0/10,203.0.113.0/24
# Alarm e-mails (with --alarms). Default: STARTTLS on 587.
# DHONOMOS_SMTP_HOST=smtp.example.net
# DHONOMOS_SMTP_USERNAME=dhonomos
# DHONOMOS_SMTP_PASSWORD=change-me
# DHONOMOS_ALARM_EMAIL_FROM=dhonomos@example.net
# DHONOMOS_ALARM_EMAIL_TO=noc@example.net,oncall@example.net
# DHONOMOS_ALARM_EMAIL_MIN_SEVERITY=major
# Two-factor auth (TOTP): accounts of these roles must set it up at first login.
# Roles: admin,operator,viewer; none = no role. Default: admin; on the internet: admin,operator.
# Needs DHONOMOS_SECRETS_KEY above: any role required + no key -> Dhonomos refuses to start.
# Other roles: optional. Not affected: API keys, DHONOMOS_API_TOKEN, single sign-on.
# Requirement off -> isolated lab only.
# If set, DHONOMOS_REQUIRE_ADMIN_TOTP=false/true -> removes/adds admin.
# DHONOMOS_REQUIRE_TOTP_ROLES=admin,operator
# DHONOMOS_REQUIRE_ADMIN_TOTP=false
# Name in authenticator apps ("<issuer>:<username>").
# DHONOMOS_TOTP_ISSUER=Dhonomos
# Single sign-on (OpenID Connect).
# DHONOMOS_OIDC_ISSUER=https://sso.example/realms/isp
# DHONOMOS_OIDC_CLIENT_ID=dhonomos
# DHONOMOS_OIDC_CLIENT_SECRET=change-me
# DHONOMOS_OIDC_REDIRECT_URL=https://dhonomos.example/api/v1/auth/oidc/callback
# DHONOMOS_OIDC_ADMIN_GROUPS=dhonomos-admins
# DHONOMOS_OIDC_OPERATOR_GROUPS=noc
# WireGuard management (docs/design/13-wireguard.md).
# Address pool: IPv4 range -> tunnel prefix per overlay network (default /24 each).
# Reuse delay: hours a revoked member's address rests before another member can get it.
# Pick a range no site LAN, ISP management network, cellular CGNAT (100.64.0.0/10)
# or Docker network on a hub host uses.
# DHONOMOS_WG_ADDRESS_POOL=10.77.0.0/16
# DHONOMOS_WG_ADDRESS_REUSE_DELAY_HOURS=24
# OpenTelemetry traces (OTLP/HTTP collector).
# DHONOMOS_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# DHONOMOS_OTLP_SAMPLE_RATIO=0.1
# Retention in days (0 = keep forever).
# DHONOMOS_EVENTS_RETENTION_DAYS=30
# DHONOMOS_TASKS_RETENTION_DAYS=90

# USP over MQTT (compose profile usp). Broker has 2 accounts, created at its first start:
# dhonomos-admin = administrator, manages Agent accounts, used only for that (--usp-dynsec).
# dhonomos-controller = Controller, only subscribes + publishes USP.
# Different passwords for the two.
MQTT_ADMIN_PASSWORD=
MQTT_CONTROLLER_PASSWORD=
# DHONOMOS_USP_MQTT_HOST=mosquitto
# DHONOMOS_USP_MQTT_USERNAME=dhonomos-controller
# DHONOMOS_USP_MQTT_PASSWORD=${MQTT_CONTROLLER_PASSWORD}
# DHONOMOS_USP_DYNSEC=true
# DHONOMOS_USP_DYNSEC_USERNAME=dhonomos-admin
# DHONOMOS_USP_DYNSEC_PASSWORD=${MQTT_ADMIN_PASSWORD}
# TLS to the broker (port 8883), optional client certificate (mutual TLS):
# DHONOMOS_USP_MQTT_TLS=true
# DHONOMOS_USP_MQTT_PORT=8883
# DHONOMOS_USP_MQTT_CA=/run/secrets/broker-ca.pem
# DHONOMOS_USP_MQTT_CLIENT_CERT=/run/secrets/dhonomos-mqtt.pem
# DHONOMOS_USP_MQTT_CLIENT_KEY=/run/secrets/dhonomos-mqtt.key
# USP over WebSocket (wss): Agents connect to /usp?eid=<EndpointID>.
# Production: TLS + client certs from the USP CA (or a vendor CA); else EndpointID = only a claim.
# EndpointID with an issued certificate (POST /devices/{id}/certificate) -> connections without
# one refused on every MTP (wss, STOMP, embedded MQTT broker).
# Revoked certificates -> refused on all MTPs + their connections closed.
# DHONOMOS_USP_WS_LISTEN=0.0.0.0:7549
# DHONOMOS_USP_WS_TLS=true
# DHONOMOS_USP_CA_DIR=/var/lib/dhonomos/usp-ca
# Name (CN) of the USP CA certificate, used only at CA creation.
# Default: "Dhonomos USP CA <8 random hex digits>" -> 2 installations never share a CA name.
# Never copy the CA directory between installations.
# DHONOMOS_USP_CA_NAME="Example USP CA"
# DHONOMOS_USP_WS_CLIENT_CERT=required
# On a network address: anything but TLS with `required` -> refused at startup, unless:
# DHONOMOS_USP_WS_ALLOW_ANONYMOUS=true
# USP over MQTT, broker embedded in Dhonomos (no external broker).
# Agents connect with MQTT 5.0 + the shared first-contact account below. Onboarding policy applies.
# DHONOMOS_USP_MQTT_BROKER_LISTEN=0.0.0.0:1883
# DHONOMOS_USP_MQTT_BROKER_USERNAME=cpe
# DHONOMOS_USP_MQTT_BROKER_PASSWORD=change-me
# TLS (port 8883) uses the wss certificate settings (--usp-ws-tls-cert/key or --usp-ca-dir):
# DHONOMOS_USP_MQTT_BROKER_TLS=true
# No account -> broker starts only on a loopback address, unless:
# DHONOMOS_USP_MQTT_BROKER_ALLOW_ANONYMOUS=true
# Where Agents publish (Controller.{i}.MTP.{i}.MQTT.Topic) + prefix of their own topic
# (prefix + EndpointID, sent in the CONNACK):
# DHONOMOS_USP_MQTT_BROKER_CONTROLLER_TOPIC=usp/controller/dhonomos
# DHONOMOS_USP_MQTT_BROKER_AGENT_TOPIC_PREFIX=usp/agent/
# Max open connections: in total + per source address (IPv6: /64); more -> closed at accept.
# 0 = unlimited (behind a TLS-terminating proxy or CGNAT: many Agents share one address).
# Embedded STOMP broker: same caps (DHONOMOS_USP_STOMP_MAX_CONNECTIONS[_PER_IP]).
# DHONOMOS_USP_MQTT_BROKER_MAX_CONNECTIONS=20000
# DHONOMOS_USP_MQTT_BROKER_MAX_CONNECTIONS_PER_IP=256
# Do not write the Controller's subscriptions (Boot!, OperationComplete, BulkData Push!)
# into Agents.
# -> Boot events, `1 BOOT` presets + completion of async commands (e.g. Download()) work only
#    through subscriptions you create on the Agent yourself.
# DHONOMOS_USP_AUTO_SUBSCRIBE=false
