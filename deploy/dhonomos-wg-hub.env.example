# dhonomos-wg-hub settings -> copy to /etc/dhonomos/wg-hub.env.
# Commented lines = defaults.

# Base URL of the Dhonomos API listener. Hub appends /api/v1/wg-hub/...
DHONOMOS_WG_HUB_SERVER=https://acs.example.org
# Allow http:// server URL. Tests only -> hub token goes in clear text.
# DHONOMOS_WG_HUB_ALLOW_HTTP=false
# Hub token (dwh_...), one line, mode 0600.
# DHONOMOS_WG_HUB_TOKEN_FILE=/etc/dhonomos/wg-hub.token
# Hub WireGuard private key, created on first start.
# Directory must exist (systemd unit creates /var/lib/dhonomos-wg-hub).
# DHONOMOS_WG_HUB_KEY_FILE=/var/lib/dhonomos-wg-hub/private.key
# Extra PEM trust anchors for the server certificate (+ system roots).
# DHONOMOS_WG_HUB_CA_FILE=
# Long-poll wait, s (1-60).
# DHONOMOS_WG_HUB_WAIT=25
# Full compare kernel vs state, every N s (>= 5).
# DHONOMOS_WG_HUB_RESYNC_INTERVAL=60
# Peer status report, every N s (>= 5).
# DHONOMOS_WG_HUB_STATUS_INTERVAL=30
# Routing table of a network = this + its listen port.
# DHONOMOS_WG_HUB_TABLE_BASE=100000
# Priority of the "iif dwg<port> lookup <table>" rules (1-32765).
# DHONOMOS_WG_HUB_RULE_PRIORITY=10000
# nft program.
# DHONOMOS_WG_HUB_NFT=nft
# Log filter (tracing env filter syntax).
# RUST_LOG=info
