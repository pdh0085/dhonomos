  "query": "\n            SELECT error AS \"error!\", COALESCE(finished_at, created_at) AS \"finished_at!\"\n            FROM tasks\n            WHERE tenant_id = $1 AND idempotency_key = ANY($2)\n              AND state = 'failed' AND error IS NOT NULL\n            ORDER BY finished_at DESC NULLS LAST, id DESC\n            ",
