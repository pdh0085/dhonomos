  "query": "\n                SELECT w.id AS \"wanted!\", d.id AS \"actual!\"\n                FROM unnest($2::uuid[], $3::text[]) AS w(id, endpoint_id)\n                JOIN devices d ON d.tenant_id = $1 AND d.protocol = 'usp'\n                              AND d.endpoint_id = w.endpoint_id\n                ",
