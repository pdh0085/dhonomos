  "query": "\n            SELECT software_version AS \"version!\", count(*) AS \"n!\" FROM devices d\n            WHERE tenant_id = $1 AND status = 'active' AND software_version IS NOT NULL\n              AND device_in_scope(d, $2)\n            GROUP BY 1 ORDER BY 2 DESC, 1 LIMIT 8\n            ",
