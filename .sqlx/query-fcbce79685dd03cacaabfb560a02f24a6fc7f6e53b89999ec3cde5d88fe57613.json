  "query": "\n            SELECT id, tenant_id, rule, devices, starts_at, ends_at, comment, created_by,\n                   created_at\n            FROM alarm_silences\n            WHERE tenant_id = $1 AND ($2 OR ends_at > now())\n            ORDER BY created_at DESC LIMIT 1000\n            ",
